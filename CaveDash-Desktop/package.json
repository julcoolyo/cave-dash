{
  "name": "cave-dash",
  "version": "1.0.0",
  "description": "Cave Dash \u2014 a geometric rhythm platformer",
  "main": "app/main.js",
  "author": "Cave Dash",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:all": "electron-builder --win nsis --mac dmg zip"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cavedash.game",
    "productName": "Cave Dash",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Cave-Dash-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}